    "html_naming": "variant_id  — lesson files are <id>_vN.html (legacy 'bare_version' entries use vN.html)",
    "problem_file": "path relative to agentic_pipeline/ with the exact problem statement",
    "answer": "canonical final answer, phrased so equivalent forms count; put non-essential detail in parentheses marked as not required",
    "external_videos": "benchmark_comparison/<id>/<tool>.{mp4,mov,webm} + optional <tool>.transcript.txt",
    "domain": "math | physics | cs — academic subject, for spread/reporting only. NOT the same thing consumers call 'subject' elsewhere (there, 'subject' means this problem's id — one problem is its own judging bucket). Adding this field does not change that.",
