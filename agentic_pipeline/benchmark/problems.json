  "_readme": [
    "SINGLE SOURCE OF TRUTH for the benchmark problem set. Consumed by:",
    "  judge/pairwise_evaluator.py (subject -> dist dir / html naming / problem file)",
    "  judge/video_meta.py         (canonical answers for the 'solved' check)",
    "  dashboard/app.py            (catalog subject dirs)",
    "  benchmark_site/build.py, results_site/build.py, dashboard_share/build.py (titles/order)",
    "Add new problems here FIRST; nothing else needs editing for a new problem",
    "that follows the conventions below."
  ],
  "conventions": {
    "id": "kebab-or-plain slug, NO underscores (variant ids are '<id>_vN')",
